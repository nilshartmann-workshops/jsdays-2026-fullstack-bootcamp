{
  "name": "backend-graphql",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:node": "nodemon --exec ts-node src/server.ts",
    "dev": "concurrently \"nodemon --exec ts-node src/server.ts\" \"npm run codegen:watch\"",
    "compile": "tsc",
    "check": "tsc --build --noEmit",
    "start": "npm run compile && node ./dist/index.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --watch --config codegen.ts",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "graphql": "^16.13.1",
    "sql.js": "^1.12.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.1.3",
    "@graphql-codegen/typescript": "5.0.9",
    "@graphql-codegen/typescript-resolvers": "5.1.7",
    "@parcel/watcher": "^2.5.6",
    "@types/node": "^25.3.5",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
